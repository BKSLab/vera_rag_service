# .dockerignore
venv
.git
.db
db.sqlite3.
.env
.env.*
!.env.example

# Серверные резервные копии и сведения о текущем развёртывании.
backups/
.deployed-release.json

# Исходные документы базы знаний — входные данные, а не часть приложения.
# Их имена длиннее лимита файловой системы сборщика, из-за чего сборка
# падала на этапе загрузки контекста.
НПА

# Не нужны в runtime-образе: тесты, кеши инструментов, бенчмарки.
tests
__pycache__
**/__pycache__
.pytest_cache
.ruff_cache
bench_*

# Материалы и отчёты, не используемые приложением.
*.docx
*.pdf
*.png
